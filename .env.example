# Application
ENV=
APP_NAME=
APP_VERSION=
APP_HOST=
APP_PORT=
DEBUG=
LOG_LEVEL=
API_V1_PREFIX=

# Database
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=
DATABASE_POOL_TIMEOUT_SECONDS=
DATABASE_POOL_RECYCLE_SECONDS=

# Authentication / JWT
JWT_SECRET=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_TTL_MINUTES=
JWT_REFRESH_TOKEN_TTL_MINUTES=

# CORS
CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
AUTH_RATE_LIMIT_REQUESTS=

# Uploads
MAX_UPLOAD_SIZE_MB=
ATTACHMENT_RETENTION_YEARS=
ALLOWED_UPLOAD_MIME_TYPES=

# Redis
REDIS_URL=

# Object storage
# Local (MinIO): `docker compose up -d` then use the values below (API 9000, console 9001).
# Production (AWS S3): leave S3_ENDPOINT_URL empty so boto3 talks to AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=plumbit
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PRESIGN_TTL_SECONDS=300

# Amazon SES
SES_FROM_EMAIL=
SES_FROM_NAME=
SES_CONFIGURATION_SET=

# WhatsApp
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Feature flags
FEATURE_EMAIL_ENABLED=
FEATURE_WHATSAPP_ENABLED=
# In-process outbox poller. False for API-only local/dev and tests.
# True in production so outbox events dispatch without waiting the poll interval.
# After-commit only nudges the poller; the poller remains the source of truth.
FEATURE_BACKGROUND_WORKERS_ENABLED=false
FEATURE_AI_FORECASTING_ENABLED=
