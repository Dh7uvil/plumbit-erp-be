                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_list_TenantPublicResponse__"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/current": {
      "get": {
        "tags": [
          "Tenants"
        ],
        "summary": "Get current organization",
        "description": "Requires `identity.organization.read`. Tenant is taken from the session.",
        "operationId": "get_current_tenant_api_v1_tenants_current_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
