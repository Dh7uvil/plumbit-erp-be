{
  "openapi": "3.1.0",
  "info": {
    "title": "Plumbit ERP API \u2014 Health",
    "description": "Process liveness and dependency readiness probes.",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "Health",
      "description": "Process liveness and dependency readiness probes."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service health",
        "description": "Report that the API process is running.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service liveness",
        "description": "Report that the API process can serve requests.",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service readiness",
        "description": "Verify that required infrastructure is available.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "A required dependency is unavailable."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthData": {
        "properties": {
          "status": {
            "type": "string",
            "const": "healthy",
            "title": "Status",
            "default": "healthy"
          }
        },
        "type": "object",
        "title": "HealthData",
        "description": "Public health state without internal diagnostics."
      },
      "HealthResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/HealthData"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta"
          }
        },
        "type": "object",
        "title": "HealthResponse",
        "description": "Successful health response envelope."
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
