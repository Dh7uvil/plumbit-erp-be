{
  "openapi": "3.1.0",
  "info": {
    "title": "Plumbit ERP API \u2014 AI Assistant",
    "description": "Read-only AI suggestions gated by feature_ai_assistant_enabled and ai.assistant.use. Requests are audit-logged; never posts to ledger or stock.",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "AI Assistant",
      "description": "Read-only AI suggestions gated by feature_ai_assistant_enabled and ai.assistant.use. Requests are audit-logged; never posts to ledger or stock."
    }
  ],
  "paths": {
    "/api/v1/ai/assist": {
      "post": {
        "tags": [
          "AI Assistant"
        ],
        "summary": "Get read-only AI suggestions",
        "description": "Returns structured, read-only guidance for a prompt. Every request is logged in ai_requests. Never posts to ledger or stock.",
        "operationId": "assist_api_v1_ai_assist_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiAssistRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_AiAssistResponse_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AiAssistRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Prompt"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AiContextEntity"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "AiAssistRequest",
        "description": "Prompt plus optional on-screen context."
      },
      "AiAssistResponse": {
        "properties": {
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/AiSuggestion"
            },
            "type": "array",
            "title": "Suggestions"
          },
          "provider": {
            "type": "string",
            "maxLength": 20,
            "title": "Provider"
          },
          "read_only": {
            "type": "boolean",
            "title": "Read Only",
            "default": true
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "suggestions",
          "provider",
          "request_id"
        ],
        "title": "AiAssistResponse",
        "description": "Structured, read-only assistant output."
      },
      "AiContextEntity": {
        "properties": {
          "entity_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Type"
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Id"
          }
        },
        "type": "object",
        "title": "AiContextEntity",
        "description": "Optional ERP record the user is asking about."
      },
      "AiSuggestion": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 8000,
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "AiSuggestion",
        "description": "Single read-only suggestion returned to the client."
      },
      "ApiResponse_AiAssistResponse_": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/AiAssistResponse"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ApiResponse[AiAssistResponse]"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
